{
  "manifest_version": 3,
  "name": "YouTube Active Watch Time Tracker",
  "version": "0.1.0",
  "description": "Tracks confirmed active YouTube playback time locally.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/content/index.ts"]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html"
  }
}